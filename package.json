  "sideEffects": [
    "./dist/element.js",
    "./src/element.ts",
    "./dist/passes/element.js",
    "./src/passes/element.ts",
    "./dist/realistic/element.js",
    "./src/realistic/element.ts",
    "./dist/realistic/element-base.js",
