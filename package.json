    "./dist/space/no-cultures.js",
    "./src/space/no-cultures.ts",
    "./dist/sky/cultures.js",
    "./src/sky/cultures.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./realistic": {
      "types": "./dist/realistic/index.d.ts",
      "import": "./dist/realistic/index.js",
      "default": "./dist/realistic/index.js"
    },
    "./realistic/element": {
      "types": "./dist/realistic/element.d.ts",
      "import": "./dist/realistic/element.js",
      "default": "./dist/realistic/element.js"
    },
    "./realistic/no-cultures": {
      "types": "./dist/realistic/no-cultures.d.ts",
      "import": "./dist/realistic/no-cultures.js",
      "default": "./dist/realistic/no-cultures.js"
    },
    "./markers": {
      "types": "./dist/markers/index.d.ts",
      "import": "./dist/markers/index.js",
      "default": "./dist/markers/index.js"
    },
    "./space": {
      "types": "./dist/space/index.d.ts",
      "import": "./dist/space/index.js",
      "default": "./dist/space/index.js"
    },
    "./space/element": {
      "types": "./dist/space/element.d.ts",
