      "import": "./dist/door/index.js",
      "default": "./dist/door/index.js"
    },
    "./meteors": {
      "types": "./dist/meteors/index.d.ts",
      "import": "./dist/meteors/index.js",
      "default": "./dist/meteors/index.js"
    },
    "./satellites": {
