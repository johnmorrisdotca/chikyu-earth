    "earth",
    "globe",
    "world",
    "countries",
    "country-outlines",
    "orthographic",
    "projection",
    "geography",
    "maps",
    "svg",
    "line-drawing",
    "rotation",
    "sidereal",
    "real-time",
    "geolocation",
    "web-component",
    "custom-element",
    "d3-geo",
    "natural-earth",
    "typescript",
    "markers",
    "satellite-imagery",
    "webgl",
    "three",
