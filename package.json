    "url": "git+https://github.com/johnmorrisdotca/chikyu-earth.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/chikyu-earth/issues"
  },
  "author": "John Morris",
  "license": "MIT",
