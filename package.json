    },
    "./passes/element": {
      "types": "./dist/passes/element.d.ts",
      "import": "./dist/passes/element.js",
      "default": "./dist/passes/element.js"
    },
    "./passes": {
      "types": "./dist/passes/index.d.ts",
      "import": "./dist/passes/index.js",
      "default": "./dist/passes/index.js"
    },
    "./sheets": {
      "types": "./dist/sheets/index.d.ts",
      "import": "./dist/sheets/index.js",
      "default": "./dist/sheets/index.js"
    },
    "./catalogue": {
      "types": "./dist/catalogue/index.d.ts",
      "import": "./dist/catalogue/index.js",
      "default": "./dist/catalogue/index.js"
    },
    "./place": {
      "types": "./dist/place/index.d.ts",
      "import": "./dist/place/index.js",
      "default": "./dist/place/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSES",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('textures','dist/textures',{recursive:true})\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.demo.json",
    "test": "node --test test/*.test.ts",
    "test:package": "pnpm build && node scripts/check-package.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/check-package.ts",
    "prepublishOnly": "pnpm check",
    "family:readme": "node scripts/family-readme.mjs",
    "site": "pnpm build && node scripts/site.ts",
    "dev": "pnpm site && node scripts/dev.ts",
    "test:demo": "pnpm site && node scripts/docs-site.mjs build && playwright test --project=chromium-desk --project=chromium-phone --project=webkit-desk --project=webkit-phone --project=chromium-gl",
    "screenshots": "pnpm site && node scripts/screenshots.ts",
    "textures": "python3 scripts/make-textures.py",
    "tiles": "python3 -I scripts/make-earth-tiles.py build",
    "test:tiles": "python3 -I scripts/make-earth-tiles.py selftest",
    "test:demo:one": "pnpm site && node scripts/docs-site.mjs build && playwright test",
    "test:soak": "pnpm site && playwright test --project=soak",
    "docs:site": "pnpm build && node scripts/docs-site.mjs build",
    "docs:check": "pnpm build && node scripts/docs-site.mjs check",
    "size": "node scripts/docs-site.mjs size",
    "test:usage": "pnpm site && node scripts/check-usage.ts",
    "test:readme": "pnpm build && node scripts/check-usage.ts readme",
    "check:standard": "node scripts/check-standard.mjs",
    "test:freeze": "pnpm site && playwright test e2e/freeze.demo.ts --project=chromium-desk"
  },
  "dependencies": {
    "@johnmorrisdotca/chizu": "^1.6.0",
    "@johnmorrisdotca/kazoku-ui": "^0.41.0",
    "d3-geo": "^3.1.1"
  },
  "peerDependencies": {
    "@johnmorrisdotca/hoshi-stars": ">=0.30.0",
    "@johnmorrisdotca/kuni": ">=1.8.0",
